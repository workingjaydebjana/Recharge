# APP_URL: The URL where this applet is hosted.
APP_URL="http://localhost:3000"

# MONGODB_URI: Optional MongoDB connection string (e.g. mongodb+srv://user:pass@cluster.mongodb.net/paysetu).
# When unset in preview/demo mode, the server uses a local persistent MongoDB-compatible store in .data/.
MONGODB_URI=""
MONGODB_DB_NAME="paysetu_recharge"

# SUPER_ADMIN_EMAIL and SUPER_ADMIN_PASSWORD: Optional pre-configured Super Admin credentials.
# If left empty, the Super Admin panel displays a secure one-time First-Run Setup form to claim the sole Super Admin account.
SUPER_ADMIN_EMAIL=""
SUPER_ADMIN_PASSWORD=""

# CREDENTIAL_ENCRYPTION_KEY: 32-byte hex secret used to encrypt stored external provider API keys at rest.
# If unset, an ephemeral server key is generated in memory for preview sessions.
CREDENTIAL_ENCRYPTION_KEY=""

# OTP_PROVIDER_ENDPOINT and OTP_PROVIDER_API_KEY: Configure a real SMS/OTP provider for production OTP delivery.
# When unset, OTP verification runs explicitly in Demo Testing Mode without claiming real SMS delivery.
OTP_PROVIDER_ENDPOINT=""
OTP_PROVIDER_API_KEY=""

# FAMGATEWAY_API_KEY: Server-side secret API key for FamGateway automated UPI payment collection.
# Set this in Settings -> Secrets or your hosting environment. Never expose with NEXT_PUBLIC_.
FAMGATEWAY_API_KEY=""
